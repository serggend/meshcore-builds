diff --git a/examples/companion_radio/RadioNoiseHistory.h b/examples/companion_radio/RadioNoiseHistory.h
new file mode 100644
index 0000000..a5b3a63
--- /dev/null
+++ b/examples/companion_radio/RadioNoiseHistory.h
@@ -0,0 +1,89 @@
+#pragma once
+#include <stdint.h>
+
+// Local diagnostics only. No changes to receive, transmit, or CAD policy.
+class RadioNoiseHistory {
+public:
+  static constexpr uint16_t Capacity = 360;
+  static constexpr uint32_t WindowMs = 10000;
+  static constexpr uint32_t SampleMs = 200;
+  struct Window {
+    int16_t floor = 0;
+    int16_t peak = 0;
+    uint8_t elevated = 0;
+    uint8_t valid = 0;
+  };
+
+  void reset(uint32_t now) {
+    _ready = true;
+    _start = now;
+    _sampleAt = now - SampleMs;
+    _current = Window();
+    _size = 0;
+    _next = 0;
+    ++_sequence;
+  }
+
+  bool shouldSample(uint32_t now) {
+    if (!_ready) reset(now);
+    advance(now);
+    if (now - _sampleAt < SampleMs) return false;
+    _sampleAt = now;
+    return true;
+  }
+
+  void sample(int16_t rssi, int16_t floor) {
+    if (floor >= 0 || rssi >= 0 || _current.valid == 255) return;
+    if (_current.valid == 0) {
+      _current.floor = floor;
+      _current.peak = rssi;
+    } else if (rssi > _current.peak) {
+      _current.peak = rssi;
+    }
+    ++_current.valid;
+    if (rssi >= _current.floor + 10) ++_current.elevated;
+  }
+
+  uint32_t latest() const { return _size ? _sequence : 0; }
+  uint32_t oldest() const { return _size ? _sequence - _size + 1 : 0; }
+
+  uint32_t ageMs(uint32_t sequence, uint32_t now) const {
+    return now - _start + (_sequence - sequence) * WindowMs;
+  }
+
+  const Window* get(uint32_t sequence) const {
+    if (!_size || sequence < oldest() || sequence > _sequence) return nullptr;
+    return &_windows[(_next + Capacity - 1 - (_sequence - sequence)) % Capacity];
+  }
+
+private:
+  Window _windows[Capacity];
+  Window _current;
+  uint32_t _sequence = 0;
+  uint32_t _start = 0;
+  uint32_t _sampleAt = 0;
+  uint16_t _next = 0;
+  uint16_t _size = 0;
+  bool _ready = false;
+
+  void push(const Window& window) {
+    _windows[_next] = window;
+    _next = (_next + 1) % Capacity;
+    if (_size < Capacity) ++_size;
+    ++_sequence;
+  }
+
+  void advance(uint32_t now) {
+    uint32_t elapsed = (now - _start) / WindowMs;
+    if (!elapsed) return;
+    _start += elapsed * WindowMs;
+    push(_current);
+    _current = Window();
+    --elapsed;
+    if (elapsed > Capacity) {
+      _sequence += elapsed - Capacity;
+      elapsed = Capacity;
+    }
+    while (elapsed-- > 0) push(_current);
+  }
+};
