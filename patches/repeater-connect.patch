@@ -0,0 +1,33 @@
+#pragma once
+// Очередь Public в ОЗУ: обработчик радио ничего не печатает в USB и не ждёт NAS.
+struct RepeaterPublicEvent {
+  uint32_t id, timestamp;
+  int16_t rssi, snr4;
+  int8_t hops;
+  uint8_t size;
+  uint8_t text[160];
+};
+struct RepeaterPublicState {
+  bool initialized = false;
+  mesh::GroupChannel channel;
+  uint32_t boot = 0, sequence = 0, dropped = 0;
+  RepeaterPublicEvent queue[8];
+  uint8_t head = 0, count = 0;
+  uint32_t tokens[8] = {}, digests[8] = {};
+  uint8_t token_head = 0;
+  bool sent = false;
+  unsigned long last_tx = 0;
+};
+
+// Отдельная очередь не вытесняет сообщения Public.
+struct RepeaterAdvertEvent {
+  uint32_t id, sender_time, received_time;
+  int16_t rssi, snr4;
+  uint8_t key[32], data[32], size;
+  int8_t hops;
+};
+struct RepeaterAdvertState {
+  RepeaterAdvertEvent queue[16];
+  uint32_t sequence = 0, dropped = 0;
+  uint8_t head = 0, count = 0;
+};
diff --git a/examples/simple_repeater/RepeaterPublic.inc b/examples/simple_repeater/RepeaterPublic.inc
new file mode 100644
index 0000000..5104161
--- /dev/null
+++ b/examples/simple_repeater/RepeaterPublic.inc
@@ -0,0 +1,123 @@
+// Расширение для локальных интерфейсов; административные радиокоманды его не вызывают.
+void MyMesh::initChannelBot() {
+  if (_channel_bot.initialized) return;
+  // Стандартный ключ Public из companion_radio, не ключ закрытого канала.
+  const uint8_t secret[16] = {0x8b,0x33,0x87,0xe9,0xc5,0xcd,0xea,0x6a,0xc9,0xe5,0xed,0xba,0xa1,0x15,0xcd,0x72};
+  memset(&_channel_bot.channel, 0, sizeof(_channel_bot.channel));
+  memcpy(_channel_bot.channel.secret, secret, sizeof(secret));
+  mesh::Utils::sha256(_channel_bot.channel.hash, sizeof(_channel_bot.channel.hash), secret, sizeof(secret));
+  getRNG()->random((uint8_t*)&_channel_bot.boot, sizeof(_channel_bot.boot));
+  _channel_bot.initialized = true;
+}
+
+int MyMesh::searchChannelsByHash(const uint8_t* hash, mesh::GroupChannel channels[], int max_matches) {
+  initChannelBot();
+  if (max_matches > 0 && memcmp(hash, _channel_bot.channel.hash, PATH_HASH_SIZE) == 0) {
+    channels[0] = _channel_bot.channel;
+    return 1;
+  }
+  return 0;
+}
+
+void MyMesh::onGroupDataRecv(mesh::Packet* pkt, uint8_t type, const mesh::GroupChannel&, uint8_t* data, size_t len) {
+  if (type != PAYLOAD_TYPE_GRP_TXT || len < 6 || (data[4] >> 2) != 0) return;
+  // У стандартного группового текста имя отправителя находится в самом тексте.
+  size_t size = strnlen((const char*)&data[5], len - 5);
+  if (size == 0 || size > 160) return;
+  if (_channel_bot.count == 8) { _channel_bot.dropped++; return; }
+  RepeaterPublicEvent& event = _channel_bot.queue[(_channel_bot.head + _channel_bot.count) % 8];
+  event.id = ++_channel_bot.sequence;
+  if (!event.id) event.id = ++_channel_bot.sequence;
+  memcpy(&event.timestamp, data, 4);
+  event.rssi = _radio->getLastRSSI();
+  event.snr4 = (int16_t)(_radio->getLastSNR() * 4);
+  // Flood path содержит уже пройденные репитеры; direct path имеет иной смысл.
+  event.hops = pkt->isRouteFlood() ? pkt->getPathHashCount() : -1;
+  event.size = size;
+  memcpy(event.text, &data[5], size);
+  _channel_bot.count++;
+  // Не помечаем DoNotRetransmit: Mesh::onRecvPacket продолжит routeRecvPacket.
+}
+
+void MyMesh::recordAdvert(mesh::Packet* pkt, const mesh::Identity& identity, uint32_t timestamp,
+                          const uint8_t* data, size_t len) {
+  initChannelBot();
+  if (len > 32) return;
+  if (_advert.count == 16) { ++_advert.dropped; return; }
+  RepeaterAdvertEvent& e = _advert.queue[(_advert.head + _advert.count) % 16];
+  e.id = ++_advert.sequence;
+  if (!e.id) e.id = ++_advert.sequence;
+  e.sender_time = timestamp; e.received_time = getRTCClock()->getCurrentTime();
+  e.rssi = _radio->getLastRSSI(); e.snr4 = (int16_t)(_radio->getLastSNR() * 4);
+  e.hops = pkt->isRouteFlood() ? pkt->getPathHashCount() : -1; e.size = len;
+  memcpy(e.key, identity.pub_key, 32); memcpy(e.data, data, len);
+  ++_advert.count;
+}
+
+bool MyMesh::handleChannelBotCommand(const char* command, char* reply, size_t capacity) {
+  if (strncmp(command, "bot ", 4) != 0) return false;
+  initChannelBot();
+  if (!strcmp(command, "bot advert-next")) {
+    if (!_advert.count) { snprintf(reply, capacity, "{\"empty\":true,\"dropped\":%lu}", (unsigned long)_advert.dropped); return true; }
+    const RepeaterAdvertEvent& e = _advert.queue[_advert.head];
+    char key[65], data[65]; mesh::Utils::toHex(key, e.key, 32); mesh::Utils::toHex(data, e.data, e.size);
+    snprintf(reply, capacity, "{\"id\":%lu,\"boot\":%lu,\"ts\":%lu,\"rx\":%lu,\"rssi\":%d,\"snr4\":%d,\"hops\":%d,\"key\":\"%s\",\"data\":\"%s\",\"dropped\":%lu}",
+      (unsigned long)e.id, (unsigned long)_channel_bot.boot, (unsigned long)e.sender_time,
+      (unsigned long)e.received_time, e.rssi, e.snr4, e.hops, key, data, (unsigned long)_advert.dropped);
+  } else if (!strncmp(command, "bot advert-ack ", 15)) {
+    char* end; unsigned long id = strtoul(command + 15, &end, 10);
+    if (*end || end == command + 15 || !_advert.count || _advert.queue[_advert.head].id != id) {
+      snprintf(reply, capacity, "ERR ack"); return true;
+    }
+    _advert.head = (_advert.head + 1) % 16; --_advert.count;
+    snprintf(reply, capacity, "OK ack");
+  } else if (!strcmp(command, "bot cap")) {
+    int max_text = 160 - (int)strnlen(_prefs.node_name, 32) - 2;
+    snprintf(reply, capacity, "{\"v\":1,\"channel\":\"Public\",\"advert\":1,\"boot\":%lu,\"max_text\":%d,\"dropped\":%lu}",
+             (unsigned long)_channel_bot.boot, max_text, (unsigned long)_channel_bot.dropped);
+  } else if (!strcmp(command, "bot next")) {
+    if (!_channel_bot.count) { snprintf(reply, capacity, "{\"empty\":true}"); return true; }
+    const RepeaterPublicEvent& e = _channel_bot.queue[_channel_bot.head];
+    char hex[321]; mesh::Utils::toHex(hex, e.text, e.size);
+    snprintf(reply, capacity, "{\"id\":%lu,\"boot\":%lu,\"ts\":%lu,\"rssi\":%d,\"snr4\":%d,\"hops\":%d,\"hex\":\"%s\"}",
+             (unsigned long)e.id, (unsigned long)_channel_bot.boot, (unsigned long)e.timestamp, e.rssi, e.snr4, e.hops, hex);
+  } else if (!strncmp(command, "bot ack ", 8)) {
+    char* end; unsigned long id = strtoul(command + 8, &end, 10);
+    if (*end || end == command + 8 || !_channel_bot.count || _channel_bot.queue[_channel_bot.head].id != id) {
+      snprintf(reply, capacity, "ERR ack"); return true;
+    }
+    _channel_bot.head = (_channel_bot.head + 1) % 8; _channel_bot.count--;
+    snprintf(reply, capacity, "OK ack");
+  } else if (!strncmp(command, "bot send ", 9)) {
+    // Токен делает повтор команды идемпотентным в пределах последних восьми отправок.
+    const char* token_hex = command + 9;
+    if (strlen(token_hex) < 10 || token_hex[8] != ' ') { snprintf(reply, capacity, "ERR syntax"); return true; }
+    char token_string[9]; memcpy(token_string, token_hex, 8); token_string[8] = 0;
+    uint8_t token_bytes[4];
+    if (!mesh::Utils::fromHex(token_bytes, 4, token_string)) { snprintf(reply, capacity, "ERR token"); return true; }
+    uint32_t token; memcpy(&token, token_bytes, 4);
+    if (!token) { snprintf(reply, capacity, "ERR token"); return true; }
+    const char* hex = token_hex + 9; size_t size = strlen(hex) / 2;
+    size_t name_len = strnlen(_prefs.node_name, 32);
+    if (!size || strlen(hex) % 2 || size + name_len + 2 > 160) { snprintf(reply, capacity, "ERR length"); return true; }
+    uint8_t text[160];
+    if (!mesh::Utils::fromHex(text, size, hex) || memchr(text, 0, size)) { snprintf(reply, capacity, "ERR text"); return true; }
+    uint32_t digest; mesh::Utils::sha256((uint8_t*)&digest, sizeof(digest), text, size);
+    for (int i = 0; i < 8; ++i) if (_channel_bot.tokens[i] == token) {
+      snprintf(reply, capacity, _channel_bot.digests[i] == digest ? "OK duplicate" : "ERR token reused"); return true;
+    }
+    unsigned long now = millis();
+    if (_channel_bot.sent && (unsigned long)(now - _channel_bot.last_tx) < 15000) { snprintf(reply, capacity, "ERR cooldown"); return true; }
+    uint8_t payload[165]; uint32_t ts = getRTCClock()->getCurrentTime();
+    memcpy(payload, &ts, 4); payload[4] = 0;
+    memcpy(&payload[5], _prefs.node_name, name_len); payload[5 + name_len] = ':'; payload[6 + name_len] = ' ';
+    memcpy(&payload[7 + name_len], text, size);
+    auto pkt = createGroupDatagram(PAYLOAD_TYPE_GRP_TXT, _channel_bot.channel, payload, 7 + name_len + size);
+    if (!pkt) { snprintf(reply, capacity, "ERR queue"); return true; }
+    sendFloodScoped(default_scope, pkt, 0, _prefs.path_hash_mode + 1);
+    int i = _channel_bot.token_head; _channel_bot.tokens[i] = token; _channel_bot.digests[i] = digest;
+    _channel_bot.token_head = (i + 1) % 8; _channel_bot.sent = true; _channel_bot.last_tx = now;
+    snprintf(reply, capacity, "OK queued");
+  } else { snprintf(reply, capacity, "ERR unknown bot command"); }
+  return true;
+}
