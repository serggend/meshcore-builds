diff --git a/examples/simple_repeater/RepeaterConsoleLine.h b/examples/simple_repeater/RepeaterConsoleLine.h
new file mode 100644
index 0000000..696cf35
--- /dev/null
+++ b/examples/simple_repeater/RepeaterConsoleLine.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <stddef.h>
+
+class RepeaterConsoleLine {
+  size_t length = 0;
+  bool invalid = false;
+  bool after_cr = false;
+
+public:
+  char text[384] = {};
+
+  // Пропускаем LF после CR и отбрасываем переполненную строку целиком.
+  bool push(unsigned char byte) {
+    const bool skip_lf = after_cr && byte == '\n';
+    after_cr = byte == '\r';
+    if (skip_lf) return false;
+    if (byte == '\r' || byte == '\n') {
+      text[length] = 0;
+      length = 0;
+      const bool ready = !invalid;
+      invalid = false;
+      return ready;
+    }
+    if (byte == 8 || byte == 127) {
+      if (length && !invalid) --length;
+    } else if (byte < 32 || length == sizeof(text) - 1) {
+      invalid = true;
+    } else if (!invalid) {
+      text[length++] = byte;
+    }
+    return false;
+  }
+};
diff --git a/examples/simple_repeater/RepeaterConsolePolicy.h b/examples/simple_repeater/RepeaterConsolePolicy.h
new file mode 100644
index 0000000..cf8552f
--- /dev/null
+++ b/examples/simple_repeater/RepeaterConsolePolicy.h
@@ -0,0 +1,63 @@
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// TCP-монитор уже USB-консоли по возможностям. Проверяем аргументы здесь,
+// чтобы неверные или изменяющие настройки команды не доходили до MyMesh.
+static bool monitor_decimal_id(const char* value) {
+  if (!value || !*value) return false;
+  uint32_t parsed = 0;
+  for (const unsigned char* p = (const unsigned char*)value; *p; ++p) {
+    if (*p < '0' || *p > '9') return false;
+    const uint32_t digit = *p - '0';
+    if (parsed > (UINT32_MAX - digit) / 10) return false;
+    parsed = parsed * 10 + digit;
+  }
+  return parsed != 0;
+}
+
+static bool monitor_hex_string(const char* value, size_t min_bytes, size_t max_bytes,
+                               bool reject_zero) {
+  if (!value) return false;
+  const size_t n = strlen(value);
+  if ((n & 1) || n < min_bytes * 2 || n > max_bytes * 2) return false;
+  bool nonzero = false;
+  for (size_t i = 0; i < n; ++i) {
+    const char c = value[i];
+    const bool hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+                     (c >= 'A' && c <= 'F');
+    if (!hex) return false;
+    if (c != '0') nonzero = true;
+  }
+  return !reject_zero || nonzero;
+}
+
+static bool monitor_command_allowed(const char* line) {
+  if (!line) return false;
+  static const char* const commands[] = {
+    "get name", "get public.key", "get role", "get radio", "get tx",
+    "get repeat", "ver", "clock", "stats-packets", "stats-radio", "stats-core",
+    "bot cap", "bot next", "bot advert-next",
+  };
+  for (const char* command : commands) {
+    if (strcmp(line, command) == 0) return true;
+  }
+  if (strncmp(line, "bot ack ", 8) == 0) return monitor_decimal_id(line + 8);
+  if (strncmp(line, "bot advert-ack ", 15) == 0) return monitor_decimal_id(line + 15);
+  if (strncmp(line, "bot send ", 9) == 0) {
+    const char* token = line + 9;
+    if (strlen(token) < 11 || token[8] != ' ') return false;
+    char token_copy[9];
+    memcpy(token_copy, token, 8);
+    token_copy[8] = 0;
+    if (!monitor_hex_string(token_copy, 4, 4, true)) return false;
+    return monitor_hex_string(token + 9, 1, 160, false);
+  }
+  if (strncmp(line, "time ", 5) != 0 || strlen(line + 5) != 10) return false;
+  uint64_t epoch = 0;
+  for (const unsigned char* p = (const unsigned char*)line + 5; *p; ++p) {
+    if (*p < '0' || *p > '9') return false;
+    epoch = epoch * 10 + (*p - '0');
+  }
+  return epoch <= 2147483647U;
+}
diff --git a/examples/simple_repeater/RepeaterLocalInterfaces.inc b/examples/simple_repeater/RepeaterLocalInterfaces.inc
new file mode 100644
index 0000000..cdf03ec
--- /dev/null
+++ b/examples/simple_repeater/RepeaterLocalInterfaces.inc
@@ -0,0 +1,316 @@
+#if defined(ESP32)
+#include <Preferences.h>
+#include <WiFi.h>
+#include <lwip/sockets.h>
+#include <helpers/esp32/SerialBLEInterface.h>
+#elif defined(NRF52_PLATFORM)
+#include <helpers/nrf52/SerialBLEInterface.h>
+#endif
+
+#include "RepeaterConsoleLine.h"
+
+static constexpr size_t reply_capacity = 512;
+static constexpr uint32_t ble_off = UINT32_MAX;
+#ifdef REPEATER_DEFAULT_BLE_PIN
+static constexpr uint32_t default_ble_pin = REPEATER_DEFAULT_BLE_PIN;
+static_assert(default_ble_pin <= 999999, "Expected a six-digit BLE PIN");
+#else
+static constexpr uint32_t default_ble_pin = ble_off;
+#endif
+static SerialBLEInterface ble;
+static uint32_t active_ble_pin = default_ble_pin;
+static RepeaterConsoleLine ble_line;
+static char ble_reply[reply_capacity + 8];
+static size_t ble_reply_offset, ble_reply_length;
+
+static size_t make_monitor_reply(char* command, char* output, size_t capacity) {
+  char reply[reply_capacity] = {};
+  the_mesh.handleMonitorCommand(command, reply, sizeof(reply));
+  return snprintf(output, capacity, "  -> %s\r\n", reply[0] ? reply : "ERR empty reply");
+}
+
+#if defined(ESP32)
+static constexpr uint16_t monitor_port = 5001;
+static constexpr char settings_namespace[] = "repeater-io";
+
+struct RepeaterWifiSettings {
+  char ssid[33];
+  char password[65];
+  uint32_t monitor_ip;
+};
+
+static RepeaterWifiSettings wifi_settings = {};
+static WiFiServer wifi_server(monitor_port);
+static WiFiClient wifi_client;
+static bool wifi_listening = false;
+static uint32_t wifi_last_rx;
+static RepeaterConsoleLine wifi_line;
+static char wifi_reply[reply_capacity + 8];
+static size_t wifi_reply_offset, wifi_reply_length;
+
+static void reset_wifi_client() {
+  wifi_client.stop();
+  wifi_line = {};
+  wifi_reply_offset = wifi_reply_length = 0;
+}
+
+static void stop_wifi_listener() {
+  reset_wifi_client();
+  if (wifi_listening) wifi_server.stop();
+  wifi_listening = false;
+}
+
+static void apply_wifi_settings() {
+  stop_wifi_listener();
+  WiFi.persistent(false);
+  WiFi.disconnect();
+  if (wifi_settings.ssid[0]) {
+    WiFi.mode(WIFI_STA);
+    WiFi.setAutoReconnect(true);
+    WiFi.begin(wifi_settings.ssid, wifi_settings.password);
+  } else {
+    WiFi.mode(WIFI_OFF);
+  }
+}
+
+static void wifi_loop() {
+  if (!wifi_settings.ssid[0] || WiFi.status() != WL_CONNECTED) {
+    if (wifi_listening) stop_wifi_listener();
+    return;
+  }
+  if (!wifi_listening) {
+    wifi_server.begin();
+    wifi_listening = true;
+  }
+  if (!wifi_client || millis() - wifi_last_rx > 45000) reset_wifi_client();
+  if (WiFiClient candidate = wifi_server.accept()) {
+    if (wifi_client || candidate.remoteIP() != IPAddress(wifi_settings.monitor_ip)) {
+      candidate.stop();
+    } else {
+      wifi_client = candidate;
+      wifi_client.setNoDelay(true);
+      wifi_last_rx = millis();
+    }
+  }
+  if (!wifi_client) return;
+  if (wifi_reply_offset < wifi_reply_length) {
+    const int written = send(wifi_client.fd(), wifi_reply + wifi_reply_offset,
+                             wifi_reply_length - wifi_reply_offset, MSG_DONTWAIT);
+    if (written > 0) {
+      wifi_reply_offset += written;
+    } else if (written == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
+      reset_wifi_client();
+    }
+    return;
+  }
+  for (int budget = 0; budget < 96 && wifi_client.available(); ++budget) {
+    const int byte = wifi_client.read();
+    if (byte < 0) break;
+    wifi_last_rx = millis();
+    if (wifi_line.push(byte)) {
+      wifi_reply_length = make_monitor_reply(wifi_line.text, wifi_reply, sizeof(wifi_reply));
+      wifi_reply_offset = 0;
+      break;
+    }
+  }
+}
+
+static bool parse_wifi_settings(char* args, RepeaterWifiSettings& result) {
+  char* ssid = strchr(args, '|');
+  if (!ssid) return false;
+  *ssid++ = 0;
+  char* password = strchr(ssid, '|');
+  if (!password) return false;
+  *password++ = 0;
+  in_addr host;
+  if (inet_pton(AF_INET, args, &host) != 1 ||
+      !ssid[0] || strlen(ssid) >= sizeof(result.ssid) ||
+      strlen(password) < 8 || strlen(password) > 63) return false;
+  const IPAddress address(host.s_addr);
+  if (address[0] == 0 || address[0] == 127 || address[0] >= 224) return false;
+  strcpy(result.ssid, ssid);
+  strcpy(result.password, password);
+  result.monitor_ip = host.s_addr;
+  return true;
+}
+
+static bool handle_wifi_config(char* command, char* reply) {
+  if (!strcmp(command, "wifi status")) {
+    snprintf(reply, reply_capacity, "Wi-Fi %s, IP %s, monitor %s:%u",
+             !wifi_settings.ssid[0] ? "off" : WiFi.status() == WL_CONNECTED ? "connected" : "connecting",
+             WiFi.localIP().toString().c_str(),
+             IPAddress(wifi_settings.monitor_ip).toString().c_str(), monitor_port);
+  } else if (!strncmp(command, "wifi set ", 9) || !strcmp(command, "wifi off")) {
+    RepeaterWifiSettings next = {};
+    if (strncmp(command, "wifi set ", 9) == 0 && !parse_wifi_settings(command + 9, next)) {
+      strcpy(reply, "ERR use wifi set IPv4|SSID|WPA-password (8-63 bytes)");
+      return true;
+    }
+    Preferences settings;
+    if (!settings.begin(settings_namespace) ||
+        settings.putBytes("wifi-v1", &next, sizeof(next)) != sizeof(next)) {
+      strcpy(reply, "ERR Wi-Fi settings not saved");
+      return true;
+    }
+    settings.end();
+    wifi_settings = next;
+    apply_wifi_settings();
+    strcpy(reply, "OK");
+  } else {
+    return false;
+  }
+  return true;
+}
+
+static void load_local_settings() {
+  Preferences settings;
+  if (!settings.begin(settings_namespace, true)) return;
+  if (settings.getBytesLength("wifi-v1") == sizeof(wifi_settings)) {
+    settings.getBytes("wifi-v1", &wifi_settings, sizeof(wifi_settings));
+    wifi_settings.ssid[sizeof(wifi_settings.ssid) - 1] = 0;
+    wifi_settings.password[sizeof(wifi_settings.password) - 1] = 0;
+  }
+  active_ble_pin = settings.getUInt("ble-pin", default_ble_pin);
+  settings.end();
+  if (wifi_settings.ssid[0]) apply_wifi_settings();
+}
+
+static bool save_ble_pin(uint32_t pin) {
+  Preferences settings;
+  return settings.begin(settings_namespace) && settings.putUInt("ble-pin", pin) == sizeof(pin);
+}
+#elif defined(NRF52_PLATFORM)
+static constexpr char ble_settings_file[] = "/repeater-ble";
+static constexpr char ble_settings_temp[] = "/repeater-ble.tmp";
+
+struct RepeaterBleSettings {
+  uint32_t pin;
+  uint32_t bonds_pin;
+};
+
+static RepeaterBleSettings ble_settings = {default_ble_pin, ble_off};
+
+static void load_local_settings() {
+  auto file = InternalFS.open(ble_settings_file, FILE_O_READ);
+  RepeaterBleSettings stored;
+  if (file && file.size() == sizeof(stored) &&
+      file.read((uint8_t*)&stored, sizeof(stored)) == sizeof(stored)) {
+    ble_settings = stored;
+    active_ble_pin = stored.pin;
+  }
+}
+
+static bool save_ble_settings(const RepeaterBleSettings& next) {
+  if (InternalFS.exists(ble_settings_temp) && !InternalFS.remove(ble_settings_temp)) return false;
+  auto file = InternalFS.open(ble_settings_temp, FILE_O_WRITE);
+  if (!file) return false;
+  const bool written = file.write((const uint8_t*)&next, sizeof(next)) == sizeof(next);
+  file.close();
+  if (!written || !InternalFS.rename(ble_settings_temp, ble_settings_file)) return false;
+  ble_settings = next;
+  return true;
+}
+
+static bool save_ble_pin(uint32_t pin) {
+  return save_ble_settings({pin, pin == ble_settings.pin ? ble_settings.bonds_pin : ble_off});
+}
+#endif
+
+static void ble_loop() {
+  if (!ble.isEnabled()) return;
+  uint8_t input[MAX_FRAME_SIZE];
+  const size_t length = ble.checkRecvFrame(input);
+  if (!ble.isConnected()) {
+    ble_line = {};
+    ble_reply_offset = ble_reply_length = 0;
+    return;
+  }
+  for (size_t i = 0; i < length; ++i) {
+    if (ble_line.push(input[i]) && ble_reply_offset == ble_reply_length) {
+      ble_reply_length = make_monitor_reply(ble_line.text, ble_reply, sizeof(ble_reply));
+      ble_reply_offset = 0;
+    }
+  }
+  if (ble_reply_offset < ble_reply_length) {
+    // 20 байт помещаются даже при стандартном ATT MTU 23.
+    const size_t length = min((size_t)20, ble_reply_length - ble_reply_offset);
+    ble_reply_offset += ble.writeFrame((const uint8_t*)ble_reply + ble_reply_offset, length);
+  }
+}
+
+static void local_interfaces_begin() {
+  load_local_settings();
+  if (active_ble_pin > 999999) return;
+  char name[32];
+  snprintf(name, sizeof(name), "%s", the_mesh.getNodeName());
+#if defined(NRF52_PLATFORM)
+  ble.begin("Repeater-", name, active_ble_pin, /*enable_dfu=*/false);
+  if (ble_settings.bonds_pin != active_ble_pin) {
+    Bluefruit.Periph.clearBonds();
+    if (!save_ble_settings({active_ble_pin, active_ble_pin})) return;
+  }
+#else
+  ble.begin("Repeater-", name, active_ble_pin, /*bond=*/false);
+#endif
+  ble.enable();
+}
+
+static bool local_interfaces_active() {
+#if defined(ESP32)
+  if (wifi_settings.ssid[0]) return true;
+#endif
+  return ble.isEnabled();
+}
+
+static bool handle_local_config(char* command, char* reply) {
+#if defined(ESP32)
+  if (handle_wifi_config(command, reply)) return true;
+#endif
+  if (!strcmp(command, "ble status")) {
+    strcpy(reply, ble.isEnabled() ? "BLE on" : "BLE off");
+  } else if (!strncmp(command, "ble set ", 8) || !strcmp(command, "ble off")) {
+    uint32_t pin = ble_off;
+    if (strncmp(command, "ble set ", 8) == 0) {
+      const char* digits = command + 8;
+      if (strlen(digits) != 6 || strspn(digits, "0123456789") != 6) {
+        strcpy(reply, "ERR use ble set with a six-digit PIN");
+        return true;
+      }
+      pin = strtoul(digits, nullptr, 10);
+    }
+    if (!save_ble_pin(pin)) {
+      strcpy(reply, "ERR BLE settings not saved");
+      return true;
+    }
+    if (ble.isEnabled() && pin != active_ble_pin) ble.disable();
+    strcpy(reply, "OK - reboot to apply");
+  } else {
+    return false;
+  }
+  return true;
+}
+
+static void local_interfaces_loop() {
+  static RepeaterConsoleLine usb_line;
+  for (int budget = 0; budget < 96 && Serial.available(); ++budget) {
+    const int byte = Serial.read();
+    if (byte < 0) break;
+    if (usb_line.push(byte)) {
+      char reply[reply_capacity] = {};
+      char* command = usb_line.text;
+      if (!handle_local_config(command, reply)) {
+        if (!strncmp(command, "bot ", 4)) {
+          the_mesh.handleMonitorCommand(command, reply, sizeof(reply));
+        } else {
+          the_mesh.handleCommand(0, command, reply);
+        }
+      }
+      if (reply[0]) Serial.printf("  -> %s\r\n", reply);
+      break;
+    }
+  }
+#if defined(ESP32)
+  wifi_loop();
+#endif
+  ble_loop();
+}
diff --git a/examples/simple_repeater/RepeaterPublic.h b/examples/simple_repeater/RepeaterPublic.h
