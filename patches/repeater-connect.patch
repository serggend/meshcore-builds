diff --git a/tests/repeater/console.cpp b/tests/repeater/console.cpp
new file mode 100644
index 0000000..9744c42
--- /dev/null
+++ b/tests/repeater/console.cpp
@@ -0,0 +1,53 @@
+#include <cassert>
+#include <cstring>
+
+#include "RepeaterConsoleLine.h"
+#include "RepeaterConsolePolicy.h"
+
+static bool feed(RepeaterConsoleLine& line, const char* input) {
+  bool ready = false;
+  while (*input) ready = line.push(*input++) || ready;
+  return ready;
+}
+
+int main() {
+  const char* accepted[] = {
+    "get name", "get public.key", "get role", "get radio", "get tx", "get repeat",
+    "ver", "clock", "stats-packets", "stats-radio", "stats-core", "time 1760000000",
+    "bot cap", "bot next", "bot ack 4294967295", "bot advert-next", "bot advert-ack 1",
+    "bot send 00000001 00FF",
+  };
+  for (const char* command : accepted) assert(monitor_command_allowed(command));
+
+  const char* rejected[] = {
+    "", "get prv.key", "get guest.password", "get acl", "reboot", "start ota", "password example",
+    "set repeat off", "set name test", "wifi status", "wifi off", "ble off",
+    "bot ack 0", "bot ack 4294967296", "bot ack -1", "bot ack 1 trailing",
+    "bot advert-ack 00", "bot send 00000000 AB", "bot send 00000001 A",
+    "bot send 00000001 G0", "bot send 00000001AB", "bot send 00000001 ",
+    "time 2147483648", "time 17600000000", "time 176000000x",
+    "get name ", "get name\nreboot", "AB|get name",
+  };
+  for (const char* command : rejected) assert(!monitor_command_allowed(command));
+
+  RepeaterConsoleLine line;
+  assert(!feed(line, "bot ad"));
+  assert(feed(line, "vert-next\r"));
+  assert(!strcmp(line.text, "bot advert-next"));
+  assert(!line.push('\n'));
+  assert(feed(line, "get nix\b\bame\n"));
+  assert(!strcmp(line.text, "get name"));
+
+  for (size_t i = 0; i < sizeof(line.text) + 8; ++i) assert(!line.push('X'));
+  assert(!feed(line, "bot ack 1\r\n"));
+  assert(feed(line, "bot cap\r"));
+  assert(!strcmp(line.text, "bot cap"));
+
+  assert(!feed(line, "get name"));
+  assert(!line.push(0));
+  assert(!feed(line, "bot ack 1\n"));
+  assert(feed(line, "bot next\r"));
+  assert(!strcmp(line.text, "bot next"));
+  assert(line.push('\r'));  // Пустая USB-строка завершает загрузку регионов.
+  assert(!strcmp(line.text, ""));
+}
