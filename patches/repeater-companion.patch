+#pragma once
+
+#include <Identity.h>
+#include <Packet.h>
+
+// Локальный Companion получает копию. Путь оригинала остаётся у репитера.
+inline mesh::Packet companionPacketView(const mesh::Packet& packet, const mesh::Identity& repeater) {
+  mesh::Packet copy = packet;
+  if (copy.isRouteDirect() && copy.getPathHashCount() == 1 &&
+      repeater.isHashMatch(copy.path, copy.getPathHashSize())) {
+    copy.setPathHashCount(0);
+  }
+  return copy;
+}
