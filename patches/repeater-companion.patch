diff --git a/tests/repeater/companion_scheduler.cpp b/tests/repeater/companion_scheduler.cpp
new file mode 100644
index 0000000..d19fe9b
--- /dev/null
+++ b/tests/repeater/companion_scheduler.cpp
@@ -0,0 +1,122 @@
+#include <cassert>
+
+#include "RepeaterCompanionPath.h"
+#include <Dispatcher.h>
+#include <helpers/StaticPoolPacketManager.h>
+
+// Тест использует только открытый идентификатор и не вызывает криптографию.
+mesh::Identity::Identity() : pub_key{} {}
+
+class TestClock : public mesh::MillisecondClock {
+public:
+  unsigned long now = 1000;
+  unsigned long getMillis() override { return now; }
+};
+
+class TestRadio : public mesh::Radio {
+public:
+  int starts = 0;
+  uint8_t last_type = 0;
+  uint8_t last_hops = 0;
+  uint8_t pending[4] = {};
+  bool has_pending = false;
+  bool receiving = true;
+
+  int recvRaw(uint8_t* data, int size) override {
+    if (!has_pending) return 0;
+    assert(size >= 4);
+    memcpy(data, pending, 4);
+    has_pending = false;
+    return 4;
+  }
+  uint32_t getEstAirtimeFor(int) override { return 1; }
+  float packetScore(float, int) override { return 1; }
+  bool startSendRaw(const uint8_t* data, int size) override {
+    assert(receiving && size >= 2);
+    ++starts;
+    receiving = false;
+    last_type = (data[0] >> PH_TYPE_SHIFT) & PH_TYPE_MASK;
+    last_hops = data[1] & 63;
+    return true;
+  }
+  bool isSendComplete() override { return !receiving; }
+  void onSendFinished() override { receiving = true; }
+  bool isInRecvMode() const override { return receiving; }
+};
+
+class TestDispatcher : public mesh::Dispatcher {
+public:
+  TestDispatcher(mesh::Radio& radio, mesh::MillisecondClock& clock,
+                 mesh::PacketManager& pool, uint8_t reserve)
+    : mesh::Dispatcher(radio, clock, pool) {
+    _reservedPackets = reserve;
+  }
+
+  mesh::DispatcherAction onRecvPacket(mesh::Packet* packet) override {
+    assert(packet->isRouteDirect());
+    assert(packet->getPathHashCount() == 1);
+    packet->setPathHashCount(0);
+    return ACTION_RETRANSMIT(0);
+  }
+};
+
+static void checkCompanionView() {
+  mesh::Identity repeater;
+  repeater.pub_key[0] = 0x17;
+  repeater.pub_key[1] = 0x35;
+  mesh::Packet original;
+  original.header = (PAYLOAD_TYPE_TXT_MSG << PH_TYPE_SHIFT) | ROUTE_TYPE_DIRECT;
+  original.setPathHashSizeAndCount(2, 1);
+  memcpy(original.path, repeater.pub_key, 2);
+  auto copy = companionPacketView(original, repeater);
+  assert(copy.getPathHashCount() == 0 && copy.getPathHashSize() == 2);
+  assert(original.getPathHashCount() == 1 && original.getPathHashSize() == 2);
+  original.path[1] ^= 1;
+  assert(companionPacketView(original, repeater).getPathHashCount() == 1);
+  original.path[1] ^= 1;
+  original.setPathHashSizeAndCount(2, 2);
+  assert(companionPacketView(original, repeater).getPathHashCount() == 2);
+  original.setPathHashSizeAndCount(2, 1);
+  original.header = (PAYLOAD_TYPE_TXT_MSG << PH_TYPE_SHIFT) | ROUTE_TYPE_FLOOD;
+  assert(companionPacketView(original, repeater).getPathHashCount() == 1);
+}
+
+int main() {
+  checkCompanionView();
+  TestClock clock;
+  TestRadio radio;
+  // Выделение с теми же лимитами, что у гибридного профиля.
+  static StaticPoolPacketManager pool(48);
+  TestDispatcher repeater(radio, clock, pool, 0);
+  TestDispatcher companion(radio, clock, pool, 32);
+  repeater.begin();
+
+  for (int i = 0; i < 16; ++i) {
+    auto* packet = companion.obtainNewPacket();
+    assert(packet);
+    packet->header = (PAYLOAD_TYPE_GRP_TXT << PH_TYPE_SHIFT) | ROUTE_TYPE_FLOOD;
+    packet->payload[0] = 0x33;
+    packet->payload_len = 1;
+    companion.sendPacket(packet, 1);
+  }
+  assert(!companion.obtainNewPacket() && pool.getFreeCount() == 32);
+
+  radio.pending[0] = (PAYLOAD_TYPE_TXT_MSG << PH_TYPE_SHIFT) | ROUTE_TYPE_DIRECT;
+  radio.pending[1] = 1;
+  radio.pending[2] = 0x17;
+  radio.pending[3] = 0xa0;
+  radio.has_pending = true;
+  // Обслуживается только физический диспетчер, как при отключённом телефоне.
+  ++clock.now;
+  repeater.loop();
+  assert(radio.starts == 1 && radio.last_type == PAYLOAD_TYPE_TXT_MSG && radio.last_hops == 0);
+  for (int tick = 0; tick < 40; ++tick) {
+    ++clock.now;
+    repeater.loop();
+    if (radio.starts >= 2) assert(radio.last_type == PAYLOAD_TYPE_GRP_TXT);
+  }
+  assert(radio.starts == 17);
+  ++clock.now;
+  repeater.loop();
+  assert(pool.getFreeCount() == 48 && pool.getOutboundTotal() == 0);
+}
